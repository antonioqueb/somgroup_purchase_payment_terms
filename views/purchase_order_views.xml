<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_order_form_somgroup" model="ir.ui.view">
        <field name="name">purchase.order.form.somgroup</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="purchase_payment_scope"
                       widget="radio"
                       string="Tipo de Compra"/>
                <field name="is_import_order" invisible="1"/>
                <field name="is_national_order" invisible="1"/>
                <field name="som_allowed_currency_ids" invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='payment_term_id']" position="attributes">
                <attribute name="domain">[('som_usage', 'in', ('both', 'purchase')), '|', ('somgroup_scope', '=', 'both'), ('somgroup_scope', '=', purchase_payment_scope)]</attribute>
            </xpath>

            <!-- La DIVISA se puede corregir aunque la OC esté confirmada:
                 una orden capturada con divisa equivocada quedaba atrapada
                 (core la vuelve readonly tras confirmar). Solo cancelada
                 queda bloqueada. Xpath sin posicional y excluyendo las
                 currency_id anidadas en x2many (regla de builds Enterprise). -->
            <xpath expr="//field[@name='currency_id'][not(ancestor::field)]" position="attributes">
                <attribute name="readonly">state == 'cancel'</attribute>
                <!-- Nacional → solo MXN · Importación → solo divisas extranjeras -->
                <attribute name="domain">[('id', 'in', som_allowed_currency_ids)]</attribute>
                <attribute name="options">{'no_create': True, 'no_open': True}</attribute>
            </xpath>

            <xpath expr="//field[@name='payment_term_id']/.." position="after">

                <div class="alert alert-warning mb-3"
                     role="status"
                     invisible="not payment_schedule_warning">
                    <strong>⚠️ Aviso de Pago:</strong>
                    <field name="payment_schedule_warning" readonly="1" nolabel="1"/>
                </div>

                <div class="mb-2" invisible="purchase_payment_scope != 'import'">
                    <span class="badge rounded-pill text-bg-warning me-1"
                          invisible="not requires_bl_date or bl_date">Fecha BL pendiente</span>
                    <span class="badge rounded-pill text-bg-warning"
                          invisible="not requires_eta or eta_date">ETA pendiente</span>
                </div>
                <group string="📦 Datos de Embarque — Importación"
                       invisible="purchase_payment_scope != 'import'"
                       col="2">
                    <group string="Conocimiento de Embarque (BL)">
                        <field name="bl_number" placeholder="Ej. MAEU123456789"/>
                        <field name="bl_date"/>
                        <field name="requires_bl_date" invisible="1"/>
                    </group>
                    <group string="Estimado de Llegada">
                        <field name="eta_date"
                               widget="date"
                               placeholder="Fecha estimada de arribo"/>
                        <field name="requires_eta" invisible="1"/>
                        <field name="telex_release_required"
                               readonly="1"
                               invisible="not telex_release_required"/>
                    </group>
                </group>

                <group string="🇲🇽 Datos de Compra Nacional"
                       invisible="purchase_payment_scope != 'national'"
                       col="2">
                    <group string="Base de Vencimiento">
                        <field name="national_due_base"/>
                        <field name="supplier_invoice_date"
                               invisible="national_due_base != 'supplier_invoice_date'"/>
                        <field name="national_reference_date"
                               invisible="national_due_base != 'manual_date'"/>
                        <field name="requires_supplier_invoice_date" invisible="1"/>
                        <field name="requires_national_reference_date" invisible="1"/>
                    </group>
                    <group string="Recepción / Entrega">
                        <field name="national_expected_receipt_date"/>
                        <field name="national_receipt_date"/>
                        <field name="requires_national_receipt_date" invisible="1"/>
                        <field name="national_payment_note"
                               placeholder="Ej. Pago contra entrega local, crédito acordado, etc."/>
                    </group>
                </group>

                <group string="💰 Resumen Financiero SOMGROUP"
                       col="4">
                    <field name="advance_amount" readonly="1" string="Anticipo"/>
                    <field name="balance_amount" readonly="1" string="Saldo Pendiente"/>
                    <field name="next_payment_date" readonly="1" string="Próx. Vencimiento"/>
                    <field name="overdue_payments" invisible="1"/>
                </group>

            </xpath>

            <xpath expr="//notebook" position="inside">

                <page string="💳 Pagos SOMGROUP"
                      name="somgroup_payment_tab">

                    <separator string="📅 Calendario de Pagos"/>

                    <div class="d-flex align-items-center mb-2 gap-2">
                        <button name="action_calculate_payment_schedule"
                                string="🔄 Calcular / Recalcular Calendario"
                                type="object"
                                class="btn btn-primary btn-sm"/>
                        <span class="text-muted small ms-2">
                            Genera hitos de pago. Importación usa BL / ETA.
                            Nacional usa la base seleccionada.
                        </span>
                    </div>

                    <field name="payment_schedule_ids" nolabel="1" class="som_pay_sched">
                        <list editable="bottom"
                              decoration-danger="state == 'overdue'"
                              decoration-success="state == 'paid'"
                              decoration-warning="state in ('pending', 'partial')">

                            <field name="purchase_payment_scope" string="Tipo" readonly="1"/>
                            <field name="payment_type" string="Tipo de Pago"/>
                            <field name="percent" string="% Porcentaje"/>
                            <field name="amount" string="Monto"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="due_date" string="Fecha Límite"/>
                            <field name="days_until_due" string="Días Restantes" readonly="1"/>

                            <field name="state"
                                   widget="badge"
                                   string="Estado"
                                   decoration-success="state == 'paid'"
                                   decoration-info="state == 'partial'"
                                   decoration-danger="state == 'overdue'"
                                   decoration-warning="state == 'pending'"/>

                            <field name="paid_date" optional="show" string="Fecha Pago"/>
                            <field name="paid_amount" optional="show" string="Monto Pagado" readonly="1"/>
                            <field name="remaining_amount" optional="show" string="Saldo" readonly="1"/>
                            <field name="advance_payment_id" optional="show" string="Pago Anticipo" readonly="1"/>
                            <field name="schedule_invoice_id" optional="show" string="Factura" readonly="1"/>
                            <field name="payment_reference" string="Referencia"/>
                            <field name="is_manual" widget="boolean" string="Manual"/>
                            <field name="note" string="Nota"/>

                            <!-- Odoo FUSIONA botones adyacentes en una sola
                                 columna (por eso se encimaban). Los campos
                                 invisibles intercalados rompen la adyacencia:
                                 cada botón queda en SU PROPIA columna. -->
                            <button name="action_register_payment"
                                    string="💵 Pagar"
                                    type="object"
                                    class="btn btn-sm btn-success"
                                    invisible="state == 'paid'"/>

                            <field name="payment_ids" column_invisible="1"/>

                            <button name="action_view_schedule_invoice"
                                    string="📄 Ver Doc."
                                    type="object"
                                    class="btn btn-sm btn-info"/>

                            <field name="partner_id" column_invisible="1"/>

                            <button name="action_view_payments"
                                    string="Ver Pagos"
                                    type="object"
                                    class="btn btn-sm btn-secondary"
                                    invisible="not payment_ids and not advance_payment_id"/>
                        </list>
                    </field>

                </page>

            </xpath>

        </field>
    </record>

    <record id="view_purchase_order_tree_somgroup" model="ir.ui.view">
        <field name="name">purchase.order.tree.somgroup</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_order']" position="after">
                <field name="purchase_payment_scope" optional="show" string="Tipo Compra"/>
                <field name="bl_date" optional="show" string="Fecha BL"/>
                <field name="eta_date" optional="show" string="ETA"/>
                <field name="supplier_invoice_date" optional="show" string="Factura Prov."/>
                <field name="national_expected_receipt_date" optional="hide" string="Recepción Esp."/>
                <field name="next_payment_date" optional="show" string="Próx. Vcto."/>
                <field name="overdue_payments" column_invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_purchase_payment_schedule_form" model="ir.ui.view">
        <field name="name">purchase.payment.schedule.form</field>
        <field name="model">purchase.payment.schedule</field>
        <field name="arch" type="xml">
            <form string="Pago Programado">
                <header>
                    <button name="action_register_payment"
                            string="💵 Registrar Pago"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'paid'"/>
                    <button name="action_mark_paid"
                            string="✓ Marcar Pagado (Manual)"
                            type="object"
                            class="btn-secondary"
                            invisible="state == 'paid'"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="pending,partial,paid"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_payments"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-credit-card"
                                invisible="not payment_ids and not advance_payment_id">
                            <field name="payment_ids" widget="statinfo" string="Pagos"/>
                        </button>

                        <button name="action_view_schedule_invoice"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Ver Documento</span>
                            </div>
                        </button>
                    </div>

                    <div class="o_form_title mb-3">
                        <field name="order_id" readonly="1"/>
                    </div>

                    <separator string="Datos del Pago"/>
                    <group col="2">
                        <group string="¿Qué se paga?">
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="purchase_payment_scope" string="Tipo Compra" readonly="1"/>
                            <field name="partner_id" string="Proveedor" readonly="1"/>
                            <field name="payment_type" string="Tipo de Pago"/>
                            <field name="percent" string="Porcentaje (%)"/>
                            <field name="amount" string="Monto a Pagar"/>
                            <field name="currency_id" string="Moneda"/>
                            <field name="is_manual" string="Entrada Manual"/>
                        </group>

                        <group string="¿Cuándo se paga?">
                            <field name="due_date" string="Fecha Límite"/>
                            <field name="days_until_due" string="Días Restantes" readonly="1"/>
                        </group>
                    </group>

                    <separator string="Estado Contable"/>
                    <group col="2">
                        <group string="Montos">
                            <field name="paid_amount" string="Monto Pagado" readonly="1"/>
                            <field name="remaining_amount" string="Saldo Restante" readonly="1"/>
                            <field name="paid_date" string="Fecha de Pago"/>
                            <field name="payment_reference" string="Referencia / Folio"/>
                        </group>

                        <group string="Documentos">
                            <field name="advance_payment_id"
                                   string="Pago Anticipo"
                                   readonly="1"
                                   invisible="payment_type == 'balance'"/>
                            <field name="schedule_invoice_id"
                                   string="Factura del Hito"
                                   readonly="1"
                                   invisible="payment_type != 'balance'"/>
                        </group>
                    </group>

                    <group col="2">
                        <group string="Notas">
                            <field name="note"
                                   nolabel="1"
                                   widget="text"
                                   placeholder="Observaciones..."/>
                        </group>
                    </group>

                    <separator string="Pagos Contables Vinculados" invisible="not payment_ids"/>
                    <field name="payment_ids" readonly="1" invisible="not payment_ids">
                        <list>
                            <field name="name" string="Referencia"/>
                            <field name="date" string="Fecha"/>
                            <field name="amount" string="Monto"/>
                            <field name="currency_id"/>
                            <field name="state"
                                   widget="badge"
                                   decoration-success="state == 'posted'"
                                   decoration-warning="state == 'draft'"
                                   decoration-danger="state == 'cancel'"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_purchase_payment_schedule_tree" model="ir.ui.view">
        <field name="name">purchase.payment.schedule.tree</field>
        <field name="model">purchase.payment.schedule</field>
        <field name="arch" type="xml">
            <list string="Calendario de Pagos"
                  decoration-danger="state == 'overdue'"
                  decoration-success="state == 'paid'"
                  decoration-info="state == 'partial'"
                  decoration-warning="state == 'pending'">

                <field name="purchase_payment_scope" string="Tipo Compra"/>
                <field name="order_id" string="Orden de Compra"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
                <field name="partner_id" string="Proveedor"/>
                <field name="payment_type" string="Tipo"/>
                <field name="percent" string="%"/>
                <field name="amount" string="Monto"/>
                <field name="currency_id"/>
                <field name="due_date" string="Fecha Límite"/>
                <field name="days_until_due" string="Días"/>

                <field name="state"
                       widget="badge"
                       decoration-success="state == 'paid'"
                       decoration-info="state == 'partial'"
                       decoration-danger="state == 'overdue'"
                       decoration-warning="state == 'pending'"/>

                <field name="paid_date" string="Fecha Pago"/>
                <field name="paid_amount" string="Pagado" readonly="1"/>
                <field name="remaining_amount" string="Saldo" readonly="1"/>
                <field name="advance_payment_id" optional="show" string="Pago Anticipo" readonly="1"/>
                <field name="schedule_invoice_id" optional="show" string="Factura" readonly="1"/>
                <field name="payment_reference" string="Referencia"/>
                <field name="is_manual" string="Manual"/>
                <field name="note" string="Nota"/>

                <button name="action_register_payment"
                        string="💵 Pagar"
                        type="object"
                        class="btn btn-sm btn-success"
                        title="Registrar Pago"
                        invisible="state == 'paid'"/>
            </list>
        </field>
    </record>

    <record id="view_purchase_payment_schedule_calendar" model="ir.ui.view">
        <field name="name">purchase.payment.schedule.calendar</field>
        <field name="model">purchase.payment.schedule</field>
        <field name="arch" type="xml">
            <calendar string="Calendario de Pagos"
                      date_start="due_date"
                      color="state"
                      quick_create="false"
                      event_limit="5">
                <field name="purchase_payment_scope" filters="1"/>
                <field name="order_id" filters="1"/>
                <field name="payment_type" filters="1"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <field name="state"/>
                <field name="note"/>
            </calendar>
        </field>
    </record>

    <record id="view_purchase_payment_schedule_gantt" model="ir.ui.view">
        <field name="name">purchase.payment.schedule.gantt</field>
        <field name="model">purchase.payment.schedule</field>
        <field name="arch" type="xml">
            <gantt string="Gantt de Pagos"
                   date_start="due_date"
                   date_stop="due_date"
                   color="state"
                   default_group_by="order_id"
                   pill_label="true"
                   plan="false"
                   precision="{'day': 'day:half', 'week': 'day:half', 'month': 'day:half'}">
                <field name="purchase_payment_scope"/>
                <field name="order_id"/>
                <field name="payment_type"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <field name="state"/>
                <field name="due_date"/>
                <field name="note"/>
            </gantt>
        </field>
    </record>

    <record id="view_purchase_payment_schedule_search" model="ir.ui.view">
        <field name="name">purchase.payment.schedule.search</field>
        <field name="model">purchase.payment.schedule</field>
        <field name="arch" type="xml">
            <search string="Buscar Pagos">
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="purchase_payment_scope"/>
                <field name="due_date"/>

                <filter string="Importación"
                        name="scope_import"
                        domain="[('purchase_payment_scope','=','import')]"/>

                <filter string="Nacional"
                        name="scope_national"
                        domain="[('purchase_payment_scope','=','national')]"/>

                <separator/>

                <filter string="Pendientes"
                        name="pending"
                        domain="[('state','=','pending')]"/>

                <filter string="Pago Parcial"
                        name="partial"
                        domain="[('state','=','partial')]"/>

                <filter string="Vencidos"
                        name="overdue"
                        domain="[('state','=','overdue')]"/>

                <filter string="Pagados"
                        name="paid"
                        domain="[('state','=','paid')]"/>

                <filter string="Vence esta semana"
                        name="due_week"
                        domain="[
                            ('due_date', '!=', False),
                            ('due_date', '&gt;=', context_today().strftime('%Y-%m-%d')),
                            ('state', 'in', ['pending', 'partial'])
                        ]"/>

                <filter string="Manuales"
                        name="manual"
                        domain="[('is_manual','=',True)]"/>

                <separator/>

                <filter string="Por Tipo Compra"
                        name="group_scope"
                        context="{'group_by': 'purchase_payment_scope'}"/>

                <filter string="Por Proveedor"
                        name="group_partner"
                        context="{'group_by': 'partner_id'}"/>

                <filter string="Por Orden"
                        name="group_order"
                        context="{'group_by': 'order_id'}"/>

                <filter string="Por Tipo Pago"
                        name="group_type"
                        context="{'group_by': 'payment_type'}"/>

                <filter string="Por Estado"
                        name="group_state"
                        context="{'group_by': 'state'}"/>

                <filter string="Por Mes"
                        name="group_month"
                        context="{'group_by': 'due_date:month'}"/>

                <filter string="Compañía"
                        name="group_company"
                        context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company"/>
            </search>
        </field>
    </record>

    <record id="action_purchase_payment_schedule" model="ir.actions.act_window">
        <field name="name">Calendario de Pagos — Compras</field>
        <field name="res_model">purchase.payment.schedule</field>
        <field name="view_mode">list,calendar,gantt,form</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No hay pagos programados.</p>
            <p>Seleccione un término SOMGROUP en la Orden de Compra y presione
               "Calcular Calendario" para generar los hitos de pago.</p>
        </field>
    </record>

    <menuitem id="menu_purchase_payment_schedule"
              name="Calendario de Pagos"
              parent="purchase.menu_purchase_root"
              action="action_purchase_payment_schedule"
              sequence="25"
              groups="purchase.group_purchase_user"/>

</odoo>