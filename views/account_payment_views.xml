<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Heredar vista form de account.payment para mostrar hito OC ── -->
    <record id="view_account_payment_form_somgroup" model="ir.ui.view">
        <field name="name">account.payment.form.somgroup</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="purchase_schedule_id" string="Hito de Pago OC"
                       readonly="state != 'draft'"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

</odoo>