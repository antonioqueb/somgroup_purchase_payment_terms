<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Multiempresa: hitos y contenedores heredan la compañía de su OC
             (related almacenado); cada usuario ve solo los de sus compañías
             seleccionadas. -->
        <record id="rule_purchase_payment_schedule_company" model="ir.rule">
            <field name="name">Calendario de Pagos: multiempresa</field>
            <field name="model_id" ref="model_purchase_payment_schedule"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_purchase_order_container_company" model="ir.rule">
            <field name="name">Contenedor de Importación: multiempresa</field>
            <field name="model_id" ref="model_purchase_order_container"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>
