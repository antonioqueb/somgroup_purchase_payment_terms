<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Correos de COMPRA con el branding SOM blanco y negro formal
         (van al PROVEEDOR, en inglés). Se re-aplican en cada -u. -->
    <record id="purchase.email_template_edi_purchase" model="mail.template">
        <field name="subject">Request for Quotation {{ object.name or 'n/a' }} — SOM Sophisticated Materials</field>
        <field name="body_html" type="html">
<div style="margin: 0; padding: 24px 0; background-color: #ffffff; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width: 620px; margin: 0 auto; background: #ffffff; border: 1px solid #000000;">
        <tr>
            <td style="padding: 26px 32px 18px; text-align: center; border-bottom: 2px solid #000000;">
                <img t-att-src="object.get_base_url() + '/theme_list_modern/static/img/logosom.png'"
                     alt="SOM Sophisticated Materials" style="height: 44px; width: auto;"/>
            </td>
        </tr>
        <tr>
            <td style="padding: 30px 32px 6px; text-align: center;">
                <div style="font-size: 13px; letter-spacing: .14em; font-weight: 600; color: #000000; text-transform: uppercase;">Request for quotation</div>
                <div style="font-size: 26px; font-weight: 800; color: #000000; margin-top: 6px;" t-out="object.name or ''">P00015</div>
            </td>
        </tr>
        <tr>
            <td style="padding: 14px 40px 8px; font-size: 14px; color: #1a1a1a; line-height: 1.7;">
                <p style="margin: 0 0 12px;">
                    Dear <b t-out="object.partner_id.name or ''">Vendor</b><t t-if="object.partner_id.parent_id"> (<t t-out="object.partner_id.parent_id.name or ''"/>)</t>,
                </p>
                <p style="margin: 0 0 12px;">
                    Please find attached our request for quotation
                    <b t-out="object.name or ''">P00015</b><t t-if="object.partner_ref"> (your reference: <b t-out="object.partner_ref or ''"/>)</t>
                    from <b t-out="object.company_id.name or ''">SOM Group</b>.
                    We would appreciate your best terms and availability.
                </p>
                <p style="margin: 0 0 12px;">
                    Should you have any questions regarding specifications,
                    quantities or logistics, please do not hesitate to contact us.
                </p>
                <p style="margin: 0;">
                    Best regards,<br/>
                    <b t-out="object.user_id.name or object.company_id.name or ''">Purchasing</b><br/>
                    <span style="color: #555555;" t-out="object.company_id.name or ''">SOM Group</span>
                </p>
            </td>
        </tr>
        <tr>
            <td style="padding: 16px 32px; background: #000000; text-align: center;">
                <div style="font-size: 11px; color: #cccccc; letter-spacing: .12em; text-transform: uppercase;">
                    <span t-out="object.company_id.name or 'SOM Group'">SOM Group</span>
                    <t t-if="object.company_id.phone"> · <span t-out="object.company_id.phone"/></t>
                    <t t-if="object.company_id.email"> · <span t-out="object.company_id.email"/></t>
                </div>
            </td>
        </tr>
    </table>
</div>
        </field>
    </record>

    <record id="purchase.email_template_edi_purchase_done" model="mail.template">
        <field name="subject">Purchase Order {{ object.name or 'n/a' }} — SOM Sophisticated Materials</field>
        <field name="body_html" type="html">
<div style="margin: 0; padding: 24px 0; background-color: #ffffff; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width: 620px; margin: 0 auto; background: #ffffff; border: 1px solid #000000;">
        <tr>
            <td style="padding: 26px 32px 18px; text-align: center; border-bottom: 2px solid #000000;">
                <img t-att-src="object.get_base_url() + '/theme_list_modern/static/img/logosom.png'"
                     alt="SOM Sophisticated Materials" style="height: 44px; width: auto;"/>
            </td>
        </tr>
        <tr>
            <td style="padding: 30px 32px 6px; text-align: center;">
                <div style="font-size: 13px; letter-spacing: .14em; font-weight: 600; color: #000000; text-transform: uppercase;">Purchase order confirmed</div>
                <div style="font-size: 26px; font-weight: 800; color: #000000; margin-top: 6px;" t-out="object.name or ''">P00015</div>
            </td>
        </tr>
        <tr>
            <td style="padding: 14px 40px 8px; font-size: 14px; color: #1a1a1a; line-height: 1.7;">
                <p style="margin: 0 0 12px;">
                    Dear <b t-out="object.partner_id.name or ''">Vendor</b><t t-if="object.partner_id.parent_id"> (<t t-out="object.partner_id.parent_id.name or ''"/>)</t>,
                </p>
                <p style="margin: 0 0 12px;">
                    Please find attached our confirmed purchase order
                    <b t-out="object.name or ''">P00015</b><t t-if="object.partner_ref"> (your reference: <b t-out="object.partner_ref or ''"/>)</t>.
                </p>
            </td>
        </tr>
        <tr>
            <td style="padding: 6px 40px 10px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border: 1px solid #000000;">
                    <tr>
                        <td style="padding: 18px 22px;">
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size: 13px; color: #1a1a1a;">
                                <tr>
                                    <td style="padding: 4px 0; color: #555555;">Order</td>
                                    <td style="padding: 4px 0; text-align: right; font-weight: 700;" t-out="object.name or ''">P00015</td>
                                </tr>
                                <tr>
                                    <td style="padding: 4px 0; color: #555555;">Total amount</td>
                                    <td style="padding: 4px 0; text-align: right; font-weight: 800; font-size: 16px; color: #000000;"
                                        t-out="format_amount(object.amount_total, object.currency_id) or ''">$ 10.00</td>
                                </tr>
                                <tr t-if="object.date_planned">
                                    <td style="padding: 4px 0; color: #555555;">Expected arrival</td>
                                    <td style="padding: 4px 0; text-align: right; font-weight: 700;" t-out="format_date(object.date_planned) or ''"/>
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
        <tr>
            <td style="padding: 4px 40px 26px; font-size: 14px; color: #1a1a1a; line-height: 1.7;">
                <p style="margin: 0 0 12px;">
                    Kindly confirm receipt of this order and share the packing
                    details through our supplier portal when your shipment is
                    ready. Thank you for your continued partnership.
                </p>
                <p style="margin: 0;">
                    Best regards,<br/>
                    <b t-out="object.user_id.name or object.company_id.name or ''">Purchasing</b><br/>
                    <span style="color: #555555;" t-out="object.company_id.name or ''">SOM Group</span>
                </p>
            </td>
        </tr>
        <tr>
            <td style="padding: 16px 32px; background: #000000; text-align: center;">
                <div style="font-size: 11px; color: #cccccc; letter-spacing: .12em; text-transform: uppercase;">
                    <span t-out="object.company_id.name or 'SOM Group'">SOM Group</span>
                    <t t-if="object.company_id.phone"> · <span t-out="object.company_id.phone"/></t>
                    <t t-if="object.company_id.email"> · <span t-out="object.company_id.email"/></t>
                </div>
            </td>
        </tr>
    </table>
</div>
        </field>
    </record>
</odoo>
